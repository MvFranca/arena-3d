{
  "name": "@arena/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@arena/sim": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.0",
    "ioredis": "^6.0.0",
    "jose": "^6.1.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
